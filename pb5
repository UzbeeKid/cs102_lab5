#include <iostream>
using namespace std;
int main() {
    int n, b = 0, a = 0, l = 0, o = 0, nn = 0;
    char c;
    cin >> n;
    while (n--) {
        cin >> c;
        switch (c) {
            case 'b': b++;
                break;
            case 'a': a++;
                break;
            case 'l': l++; 
                break;
            case 'o': o++;
                break;
            case 'n': nn++;
                break;
        }
    }
    int ans = b;
    if (a < ans) ans = a;
    if (l / 2 < ans) ans = l / 2;
    if (o / 2 < ans) ans = o / 2;
    if (nn < ans) ans = nn;
    cout << ans;
}
