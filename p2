#include <iostream>
using namespace std;

int main() {
  int x;
  cin >> x;
  int d = 1;
  while (x / d >= 10)
    d = d * 10;
  while (x > 0) {
    if (x / d != x % 10) {
      cout << "false";
      return 0;
    }
    x = x % d / 10;
    d = d / 100;
  }
  cout << (x == 0 ? "true" : "false");
  return 0;
}
